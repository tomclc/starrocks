CREATE TABLE geo_perf (
    id BIGINT NOT NULL,
    lat DOUBLE NOT NULL,
    lng DOUBLE NOT NULL,
    payload VARCHAR(200),
    INDEX idx_s2 (lat, lng) USING S2 ("cell_level" = "15")
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 4
PROPERTIES ("replication_num" = "1");
