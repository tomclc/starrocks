-- name: test_create_s2_index @sequential @native
ADMIN SET FRONTEND CONFIG("enable_experimental_s2" = "true");

CREATE DATABASE test_s2_db_${uuid0};
USE test_s2_db_${uuid0};

-- Create table with S2 index on lat/lng pair
CREATE TABLE `t_s2_latlng` (
  `id` bigint(20) NOT NULL COMMENT "",
  `lat` double NOT NULL COMMENT "",
  `lng` double NOT NULL COMMENT "",
  INDEX idx_s2_geo (`lat`, `lng`) USING S2 ("cell_level" = "15")
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES (
"replication_num" = "1",
"compression" = "LZ4"
);

SHOW CREATE TABLE t_s2_latlng;

DROP TABLE t_s2_latlng;

-- Create table with S2 index on single VARCHAR column
CREATE TABLE `t_s2_wkt` (
  `id` bigint(20) NOT NULL COMMENT "",
  `geo` varchar(65535) NOT NULL COMMENT "",
  INDEX idx_s2_geo (`geo`) USING S2 ("cell_level" = "15")
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES (
"replication_num" = "1",
"compression" = "LZ4"
);

SHOW CREATE TABLE t_s2_wkt;

DROP TABLE t_s2_wkt;

DROP DATABASE test_s2_db_${uuid0};

ADMIN SET FRONTEND CONFIG("enable_experimental_s2" = "false");

-- name: test_s2_index_ddl @sequential @native
ADMIN SET FRONTEND CONFIG("enable_experimental_s2" = "true");

CREATE DATABASE test_s2_ddl_db_${uuid0};
USE test_s2_ddl_db_${uuid0};

-- Create table without S2 index, then add it
CREATE TABLE `t_s2_ddl` (
  `id` bigint(20) NOT NULL COMMENT "",
  `lat` double NOT NULL COMMENT "",
  `lng` double NOT NULL COMMENT ""
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES (
"replication_num" = "1",
"compression" = "LZ4"
);

-- Add S2 index via CREATE INDEX
CREATE INDEX idx_s2 ON t_s2_ddl (lat, lng) USING S2 ("cell_level" = "15");
function: wait_alter_table_finish()

-- Drop S2 index
DROP INDEX idx_s2 ON t_s2_ddl;
function: wait_alter_table_finish()

-- Add via ALTER TABLE
ALTER TABLE t_s2_ddl ADD INDEX idx_s2_alt (lat, lng) USING S2;
function: wait_alter_table_finish()

ALTER TABLE t_s2_ddl DROP INDEX idx_s2_alt;
function: wait_alter_table_finish()

DROP TABLE t_s2_ddl;
DROP DATABASE test_s2_ddl_db_${uuid0};

ADMIN SET FRONTEND CONFIG("enable_experimental_s2" = "false");

